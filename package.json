{
  "name": "vibemeal-house",
  "version": "1.0.4",
  "description": "Meal planning and grocery management for Windows",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dist": "vite build && node scripts/copy-schema.js && electron-builder --win --publish=never",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "@electron/rebuild": "^4.0.3",
    "typescript": "^5.7.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.28.0"
  }
}
